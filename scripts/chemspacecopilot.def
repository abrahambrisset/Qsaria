Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

%labels
    Author abrisset
    Project ChemSpaceCopilot
    Description Dev-friendly Apptainer image for ChemSpaceCopilot with GPU support

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PATH=/opt/venv/bin:/usr/local/bin:$PATH
    export PYTHONPATH=/app/src
    export CS_COPILOT_AGENT_TEAM=main

%files
    pyproject.toml /opt/build/pyproject.toml
    uv.lock /opt/build/uv.lock
    README.md /opt/build/README.md

%post
    set -eux

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        git \
        curl \
        build-essential \
        pkg-config \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libx11-6 \
        ca-certificates
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    /opt/venv/bin/python -m ensurepip --upgrade
    /opt/venv/bin/python -m pip install --upgrade pip setuptools wheel
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

    mkdir -p /app /opt/build /opt/build/uv-cache /app/data/model_assets/checkpoints/tabicl
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_CACHE_DIR=/opt/build/uv-cache

    uv sync \
        --frozen \
        --no-install-project \
        --extra prediction \
        --project /opt/build

    uv pip install --python /opt/venv/bin/python \
        "chemprop>=2.2.0" \
        "lightgbm>=4.5.0" \
        "tabicl>=2.0.3" \
        "chembl-structure-pipeline>=1.2.4"

    /opt/venv/bin/python -c "import chainlit, torch, lightgbm, tabicl; from agno.models.openrouter import OpenRouter; from chembl_structure_pipeline import checker, standardizer; print(chainlit.__file__); print(torch.__version__); print(lightgbm.__version__); print(tabicl.__file__); print('OpenRouter OK'); print('ChEMBL structure pipeline OK')"

    mkdir -p /opt/model_assets/checkpoints/tabicl /app/data/model_assets/checkpoints/tabicl
    for checkpoint in \
        tabicl-regressor-v2-20260212.ckpt \
        tabicl-classifier-v2-20260212.ckpt; \
    do \
        /opt/venv/bin/python -c "from pathlib import Path; import sys; from huggingface_hub import hf_hub_download; name = sys.argv[1]; target = Path('/opt/model_assets/checkpoints/tabicl'); downloaded = Path(hf_hub_download(repo_id='jingang/TabICL', filename=name, local_dir=target)); dest = target / name; downloaded.replace(dest) if downloaded.resolve() != dest.resolve() else None; assert dest.is_file() and dest.stat().st_size > 0, dest" "$checkpoint"; \
    done
    cp /opt/model_assets/checkpoints/tabicl/*.ckpt /app/data/model_assets/checkpoints/tabicl/

%runscript
    exec /bin/bash "$@"
